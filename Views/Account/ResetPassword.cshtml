@model TimeTrackingSystem.Models.ViewModels.ResetPasswordViewModel

<section class="auth-page">

    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Ustaw nowe hasło</h1>
            <p>Wprowadź nowe hasło dla swojego konta i potwierdź je poniżej.</p>
        </div>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary">
            </div>

            <div class="auth-form-group">
                <label asp-for="NewPassword" class="form-label">
                    Nowe hasło
                </label>

                <div class="auth-input-wrapper">
                    <i class="bi bi-lock auth-input-icon"></i>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control auth-input"
                           autocomplete="new-password"
                           placeholder="Wprowadź nowe hasło" />
                </div>

                <span asp-validation-for="NewPassword"
                      class="auth-field-error">
                </span>
            </div>

            <div class="auth-form-group">
                <label asp-for="ConfirmNewPassword" class="form-label">
                    Potwierdź nowe hasło
                </label>

                <div class="auth-input-wrapper">
                    <i class="bi bi-lock-fill auth-input-icon"></i>

                    <input asp-for="ConfirmNewPassword"
                           type="password"
                           class="form-control auth-input"
                           autocomplete="new-password"
                           placeholder="Powtórz nowe hasło" />
                </div>

                <span asp-validation-for="ConfirmNewPassword"
                      class="auth-field-error">
                </span>
            </div>


            <button type="submit" class="auth-submit-button">
                <i class="bi bi-check2-circle"></i>
                Zapisz nowe hasło
            </button>

        </form>

        <div class="auth-footer">
            <a asp-controller="Account" asp-action="Login" class="auth-back-link">
                <i class="bi bi-arrow-left"></i>
                Powrót do logowania
            </a>
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
