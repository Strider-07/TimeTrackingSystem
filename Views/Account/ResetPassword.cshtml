@model TimeTrackingSystem.Models.ViewModels.ResetPasswordViewModel;
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-controller="Account" asp-action="ResetPassword">
    <input type="hidden" asp-for="Token"/>
    <input type="hidden" asp-for="Email"/>

    <label class="form-label" asp-for="NewPassword">Nowe hasło</label>
    <input class="form-control" type="password" autocomplete="new-password" asp-for="NewPassword"/>
    <label class="form-label" asp-for="ConfirmNewPassword">Potwierdź nowe hasło</label>
    <input class="form-control" type="password" autocomplete="new-password" asp-for="ConfirmNewPassword"/>
    <button class="btn btn-primary" type="submit">Zmień hasło</button>


</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}