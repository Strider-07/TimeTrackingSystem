@model TimeTrackingSystem.Models.ViewModels.ForgotPasswordViewModel

<section class="auth-page">

    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-envelope-lock"></i>
            </div>

            <h1>Zapomniałeś hasła?</h1>
            <p>Podaj adres email przypisany do konta. Jeśli konto istnieje, otrzymasz instrukcje resetowania hasła.</p>
        </div>

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary">
            </div>

            <div class="auth-form-group">
                <label asp-for="Email" class="form-label">
                    Adres email
                </label>

                <div class="auth-input-wrapper">
                    <i class="bi bi-envelope auth-input-icon"></i>

                    <input asp-for="Email"
                           type="email"
                           class="form-control auth-input"
                           autocomplete="email"
                           placeholder="np. jan@example.com" />
                </div>

                <span asp-validation-for="Email"
                      class="auth-field-error">
                </span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="auth-alert auth-alert-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="auth-alert auth-alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <button type="submit" class="auth-submit-button">
                <i class="bi bi-send"></i>
                Wyślij instrukcje
            </button>

        </form>

        <div class="auth-footer">
            <a asp-controller="Account" asp-action="Login" class="auth-back-link">
                <i class="bi bi-arrow-left"></i>
                Powrót do logowania
            </a>
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
