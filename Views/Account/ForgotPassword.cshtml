@model TimeTrackingSystem.Models.ViewModels.ForgotPasswordViewModel
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    <label class="form-label" asp-for="Email">Adres Email</label>
    <input class="form-control" asp-for="Email" type="email"/>
    <button class="btn btn-primary" type="submit">Wyślij</button>
</form>
@if(TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
