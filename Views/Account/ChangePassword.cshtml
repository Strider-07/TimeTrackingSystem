@model TimeTrackingSystem.Models.ViewModels.ChangePasswordViewModel

<section class="auth-page">

    <div class="auth-card auth-card-wide">

        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Zmiana hasła</h1>
            <p>Zaktualizuj hasło swojego konta, aby zachować jego bezpieczeństwo.</p>
        </div>

        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary">
            </div>

            <div class="auth-form-group">
                <label asp-for="CurrentPassword" class="form-label">
                    Aktualne hasło
                </label>

                <div class="auth-input-wrapper">
                    <i class="bi bi-lock auth-input-icon"></i>

                    <input asp-for="CurrentPassword"
                           type="password"
                           class="form-control auth-input"
                           autocomplete="current-password"
                           placeholder="Wprowadź aktualne hasło" />
                </div>

                <span asp-validation-for="CurrentPassword"
                      class="auth-field-error">
                </span>
            </div>

            <div class="auth-form-group">
                <label asp-for="NewPassword" class="form-label">
                    Nowe hasło
                </label>

                <div class="auth-input-wrapper">
                    <i class="bi bi-lock-fill auth-input-icon"></i>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control auth-input"
                           autocomplete="new-password"
                           placeholder="Wprowadź nowe hasło" />
                </div>

                <span asp-validation-for="NewPassword"
                      class="auth-field-error">
                </span>
            </div>

            <div class="auth-form-group">
                <label asp-for="ConfirmPassword" class="form-label">
                    Potwierdź nowe hasło
                </label>

                <div class="auth-input-wrapper">
                    <i class="bi bi-lock-fill auth-input-icon"></i>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control auth-input"
                           autocomplete="new-password"
                           placeholder="Powtórz nowe hasło" />
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="auth-field-error">
                </span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="auth-alert auth-alert-success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="auth-alert auth-alert-danger">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <button type="submit" class="auth-submit-button">
                <i class="bi bi-shield-check"></i>
                Zmień hasło
            </button>

        </form>

        <div class="auth-footer">
            <a asp-controller="Home" asp-action="Index" class="auth-back-link">
                <i class="bi bi-arrow-left"></i>
                Powrót do panelu
            </a>
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
