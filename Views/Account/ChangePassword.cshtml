@model TimeTrackingSystem.Models.ViewModels.ChangePasswordViewModel
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-controller="Account" asp-action="ChangePassword" method="post">

    <label class="form-label" asp-for="CurrentPassword">Current password</label>
    <input class="form-control" asp-for="CurrentPassword" type="password"/>
    <span class="text-danger" asp-validation-for="CurrentPassword"></span>

    <label class="form-label" asp-for="NewPassword">New password</label>
    <input class="form-control" asp-for="NewPassword" type="password" />
    <span class="text-danger" asp-validation-for="NewPassword"></span>

    <label class="form-label" asp-for="ConfirmPassword">Confirm new password</label>
    <input class="form-control" asp-for="ConfirmPassword" type="password" />
    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
    <button class="btn btn-primary">Confirm</button>


</form>
