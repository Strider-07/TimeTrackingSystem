<!DOCTYPE html>
<html lang="pl" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeTrackingSystem</title>

    <script type="importmap"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/colors.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TimeTrackingSystem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-layout">
    <header>
        <nav class="navbar navbar-expand-sm app-navbar mb-3">
            <div class="container-fluid">

                
                <a class="navbar-brand app-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="app-brand-icon">
                        <i class="bi bi-clock-history"></i>
                    </span>

                    TimeTrackingSystem
                </a>

                
                <button class="navbar-toggler app-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <i class="bi bi-list"></i>
                </button>

                
                <div class="navbar-collapse collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link app-nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link app-nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">

                                <i class="bi bi-shield-check"></i>
                                Privacy
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="LeaveCalendar"
                                   asp-action="Index">

                                    <i class="bi bi-calendar3"></i>
                                    Kalendarz urlopów
                                </a>
                            </li>
                        }

                    </ul>


                    



                    

                    <div class="app-navbar-actions">
                        <div class="quick-nav dropdown">
                            <button class="quick-nav-toggle"
                                    type="button"
                                    aria-expanded="false">
                                <i class="bi bi-grid-fill"></i>
                                <span>Nawigacja</span>
                                <i class="bi bi-chevron-down quick-nav-chevron"></i>
                            </button>

                            <ul class="dropdown-menu quick-nav-menu">

                                <li>
                                    <a class="dropdown-item quick-nav-item"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        <i class="bi bi-house-fill"></i>
                                        <span>Home</span>
                                    </a>
                                </li>

                                @if (User.IsInRole("Administrator"))
                                {
                                    <li>
                                        <a class="dropdown-item quick-nav-item"
                                           asp-controller="Admin"
                                           asp-action="Index">
                                            <i class="bi bi-shield-lock-fill"></i>
                                            <span>Panel administratora</span>
                                        </a>
                                    </li>
                                }

                                @if (User.IsInRole("Administrator") || User.IsInRole("Kierownik"))
                                {
                                    <li>
                                        <hr class="dropdown-divider quick-nav-divider">
                                    </li>

                                    <li>
                                        <a class="dropdown-item quick-nav-item management-item"
                                           asp-controller="TimeEntry"
                                           asp-action="Users">
                                            <i class="bi bi-people-fill"></i>
                                            <span>Ewidencja pracowników</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item quick-nav-item management-item"
                                           asp-controller="LeaveRequest"
                                           asp-action="Manage">
                                            <i class="bi bi-calendar2-check"></i>
                                            <span>Wnioski pracowników</span>
                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider quick-nav-divider">
                                </li>

                                <li>
                                    <a class="dropdown-item quick-nav-item"
                                       asp-controller="TimeEntry"
                                       asp-action="Index">
                                        <i class="bi bi-clock-fill"></i>
                                        <span>Ewidencja czasu pracy</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item quick-nav-item"
                                       asp-controller="LeaveRequest"
                                       asp-action="Index">
                                        <i class="bi bi-calendar-event-fill"></i>
                                        <span>Wnioski urlopowe</span>
                                    </a>
                                </li>

                            </ul>
                        </div>
                        <button type="button"
                                class="app-theme-button"
                                onclick="changeTheme(); updateThemeButton();"
                                id="themeButton">

                            <i class="bi bi-moon-stars" id="themeIcon"></i>
                            <span id="themeButtonText">Motyw</span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account"
                               asp-action="ChangePassword"
                               class="app-logout-button text-decoration-none">

                                <i class="bi bi-key"></i>
                                Zmień hasło
                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="app-logout-form">

                                <button type="submit" class="app-logout-button">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Wyloguj
                                </button>
                            </form>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    
    <div class="container app-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <footer class="app-footer">
        <div class="container app-footer-content">
            <span>
                <i class="bi bi-clock-history"></i>
                &copy; 2026 TimeTrackingSystem
            </span>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="app-footer-link">
                Privacy
            </a>
        </div>
    </footer>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            function updateThemeButton() {
                const theme = document.documentElement.getAttribute("data-theme");
                const icon = document.getElementById("themeIcon");
                const text = document.getElementById("themeButtonText");

                if (!icon || !text) return;

                if (theme === "dark") {
                    icon.className = "bi bi-sun";
                    text.textContent = "Jasny motyw";
                } else {
                    icon.className = "bi bi-moon-stars";
                    text.textContent = "Ciemny motyw";
                }
            }

            document.addEventListener("DOMContentLoaded", updateThemeButton);
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
