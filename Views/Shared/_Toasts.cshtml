@{
    var toasts = new List<(string Message, string Css, string Icon, int Delay)>();

    if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
        toasts.Add((success, "text-bg-success", "bi-check-circle-fill", 5000));

    if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
        toasts.Add((error, "text-bg-danger", "bi-exclamation-circle-fill", 8000));
}

@if (toasts.Count > 0)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        @foreach (var t in toasts)
        {
            <div class="toast align-items-center @t.Css border-0"
                 role="alert" aria-live="assertive" aria-atomic="true"
                 data-bs-delay="@t.Delay">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi @t.Icon me-2"></i>@t.Message
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Zamknij"></button>
                </div>
            </div>
        }
    </div>

    <script>
        document.querySelectorAll('.toast-container .toast')
            .forEach(el => bootstrap.Toast.getOrCreateInstance(el).show());
    </script>
}