@model TimeTrackingSystem.Models.ViewModels.PaginationViewModel<TimeTrackingSystem.Models.Entities.LeaveRequest>

<section class="leave-page">

    <div class="leave-header">
        <div class="leave-header-content">
            <h1>Wnioski do rozpatrzenia</h1>
            <p>Przeglądaj i podejmuj decyzje dotyczące wniosków urlopowych.</p>
        </div>

        <div class="leave-header-count">
            <div class="leave-header-count-icon">
                <i class="bi bi-files"></i>
            </div>

            <div class="leave-header-count-content">
                <span>Łącznie wniosków</span>
                <strong>@Model.AllItems.Count</strong>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Items.Any())
    {
        <div class="leave-list">

            @foreach (var request in Model.Items)
            {
                var status = request.Status.ToString().ToLowerInvariant();

                var statusClass =
                    status.Contains("zaakcept") || status.Contains("approved") || status.Contains("accept")
                    ? "leave-status-success"
                    : status.Contains("odrzu") || status.Contains("reject") || status.Contains("decline")
                    ? "leave-status-danger"
                    : "leave-status-warning";

                var statusIcon =
                    status.Contains("zaakcept") || status.Contains("approved") || status.Contains("accept")
                    ? "bi-check-circle-fill"
                    : status.Contains("odrzu") || status.Contains("reject") || status.Contains("decline")
                    ? "bi-x-circle-fill"
                    : "bi-clock-fill";

                <div class="leave-request-card">

                    <!-- REQUEST HEADER -->

                    <div class="leave-request-top">

                        <div class="leave-request-main">

                            <div class="leave-request-icon">
                                <i class="bi bi-calendar-event"></i>
                            </div>

                            <div class="leave-request-employee">
                                <span class="leave-detail-label">
                                    <i class="bi bi-person"></i>
                                    Pracownik
                                </span>

                                <h4>
                                    @request.User.FirstName @request.User.LastName
                                </h4>
                            </div>

                            <div>
                                <span class="leave-detail-label">
                                    Rodzaj urlopu
                                </span>

                                <h3>@request.LeaveType</h3>
                            </div>

                        </div>

                        <span class="leave-status @statusClass">
                            <i class="bi @statusIcon"></i>
                            @request.Status
                        </span>

                    </div>

                    <div class="leave-request-divider"></div>

                    <!-- REQUEST DETAILS -->

                    <div class="leave-request-details">

                        <div class="leave-detail">
                            <span class="leave-detail-label">
                                <i class="bi bi-calendar-check"></i>
                                Data rozpoczęcia
                            </span>

                            <strong>
                                @request.StartDate.ToString("dd.MM.yyyy")
                            </strong>
                        </div>

                        <div class="leave-detail">
                            <span class="leave-detail-label">
                                <i class="bi bi-calendar-x"></i>
                                Data zakończenia
                            </span>

                            <strong>
                                @request.EndDate.ToString("dd.MM.yyyy")
                            </strong>
                        </div>

                    </div>

                    <!-- EMPLOYEE REASON -->

                    <div class="leave-request-reason">

                        <span class="leave-detail-label">
                            <i class="bi bi-chat-left-text"></i>
                            Uzasadnienie pracownika
                        </span>

                        @if (!string.IsNullOrWhiteSpace(request.Reason))
                        {
                            <p>@request.Reason</p>
                        }
                        else
                        {
                            <p>Brak dodatkowych uwag.</p>
                        }

                    </div>

                    <!-- MANAGER DECISION -->
                    @if (status.Contains("pending") || status.Contains("oczek") || status.Contains("oczekuj"))
                    {
                        <form asp-controller="LeaveRequest"
                              asp-action="ChangeRequestStatus"
                              method="post"
                              class="leave-decision-form leave-decision-reveal">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@request.Id" />

                            <div class="leave-decision-header">

                                <div class="leave-decision-icon">
                                    <i class="bi bi-clipboard-check"></i>
                                </div>

                                <div>
                                    <h5>Decyzja dotycząca wniosku</h5>
                                    <p>Wybierz, czy chcesz zaakceptować, czy odrzucić wniosek.</p>
                                </div>

                            </div>

                            <div class="leave-decision-options">

                                <label class="leave-decision-option accept-option">

                                    <input type="radio"
                                           name="Status"
                                           value="Zaakceptowany"
                                           required />

                                    <span class="decision-option-content">

                                        <i class="bi bi-check-circle-fill"></i>

                                        <span>
                                            <strong>Zaakceptuj</strong>
                                            <small>Zaakceptuj wniosek urlopowy</small>
                                        </span>

                                    </span>

                                </label>

                                <label class="leave-decision-option decline-option">

                                    <input type="radio"
                                           name="Status"
                                           value="Odrzucony"
                                           required />

                                    <span class="decision-option-content">

                                        <i class="bi bi-x-circle-fill"></i>

                                        <span>
                                            <strong>Odrzuć</strong>
                                            <small>Odrzuć wniosek urlopowy</small>
                                        </span>

                                    </span>

                                </label>

                            </div>

                            <div class="leave-decline-reason" hidden>

                                <label for="ReviewerComment-@request.Id">
                                    Powód odrzucenia
                                </label>

                                <textarea id="ReviewerComment-@request.Id"
                                          name="reason"
                                          class="form-control reviewer-comment-input"
                                          rows="3"
                                          placeholder="Wyjaśnij, dlaczego wniosek został odrzucony..."></textarea>

                            </div>

                            <div class="leave-decision-actions">

                                <button type="submit" class="btn btn-primary leave-decision-submit">
                                    <i class="bi bi-check-lg"></i>
                                    Potwierdź decyzję
                                </button>

                            </div>

                        </form>
                    }

                </div>
            }
            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-container" aria-label="Nawigacja stron">

                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Manage"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="pagination-arrow">
                            <i class="bi bi-chevron-left"></i>

                        </a>
                    }

                    <div class="pagination-pages">
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 1);
                            int endPage = Math.Min(Model.TotalPages, startPage + 2);
                            startPage = Math.Max(1, endPage - 2);
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <a asp-action="Manage"
                               asp-route-page="@i"
                               class="pagination-page @(i == Model.CurrentPage ? "active" : "")"
                               aria-current="@(i == Model.CurrentPage ? "page" : null)">
                                @i
                            </a>
                        }
                    </div>

                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Manage"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="pagination-arrow">

                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }

                    <form asp-action="Manage"
                          method="get"
                          class="pagination-jump">

                        <input type="number"
                               name="page"
                               min="1"
                               max="@Model.TotalPages"
                               value="@Model.CurrentPage"
                               aria-label="Numer strony"
                               required />

                        <span>/ @Model.TotalPages</span>

                        <button type="submit" title="Przejdź do strony">
                            <i class="bi bi-arrow-right"></i>
                        </button>

                    </form>

                </nav>
            }
        </div>
    }
    else
    {
        <div class="leave-empty card">

            <div class="card-body">

                <div class="leave-empty-icon">
                    <i class="bi bi-clipboard-check"></i>
                </div>

                <h3>Brak wniosków do rozpatrzenia</h3>

                <p>
                    Wszystkie wnioski zostały rozpatrzone.
                    Na ten moment nie ma żadnych oczekujących zgłoszeń.
                </p>

            </div>

        </div>
    }
    <div class="leave-back">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Powrót
        </a>
    </div>

</section>

@section Scripts {

    <script>
        document.querySelectorAll(".leave-decision-form").forEach(form => {

            const radios = form.querySelectorAll('input[name="Status"]');
            const reasonContainer = form.querySelector(".leave-decline-reason");

            function updateReasonVisibility() {

                const selected = form.querySelector('input[name="Status"]:checked');

                const shouldShow = selected?.value === "Odrzucony";

                reasonContainer.hidden = !shouldShow;
            }

            radios.forEach(radio => {
                radio.addEventListener("change", updateReasonVisibility);
            });

            updateReasonVisibility();

        });
    </script>

}