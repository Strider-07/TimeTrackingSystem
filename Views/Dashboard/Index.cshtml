@model TimeTrackingSystem.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="admin-page">
    <div class="admin-header">
        <div>
            <span class="admin-eyebrow">PRZEGLĄD</span>
            <h1>Dashboard</h1>
            <p>Podsumowanie czasu pracy i wniosków w bieżącym miesiącu.</p>
            <p>Może być potrzebne odświeżenie strony do zaaktualizowania danych.</p>
        </div>
        <div class="admin-header-icon"><i class="bi bi-speedometer2"></i></div>
    </div>

    <div class="dashboard-stats">
        <div class="report-summary-card">
            <div class="report-summary-icon employee-count-icon"><i class="bi bi-people-fill"></i></div>
            <div><span class="report-summary-label">Pracownicy</span><h2>@Model.EmployeesCount</h2></div>
        </div>
        <div class="report-summary-card">
            <div class="report-summary-icon total-time-icon"><i class="bi bi-play-circle-fill"></i></div>
            <div><span class="report-summary-label">Teraz w pracy</span><h2>@Model.WorkingNowCount</h2></div>
        </div>
        <div class="report-summary-card">
            <div class="report-summary-icon employee-count-icon"><i class="bi bi-sun-fill"></i></div>
            <div><span class="report-summary-label">Na urlopie dziś</span><h2>@Model.OnLeaveTodayCount</h2></div>
        </div>
        <div class="report-summary-card">
            <div class="report-summary-icon total-time-icon"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <span class="report-summary-label">Oczekujące wnioski</span>
                <h2>@Model.PendingRequestsCount</h2>
            </div>
        </div>
    </div>

    <div class="dashboard-charts">
        <div class="admin-table-card dashboard-chart-card wide">
            <div class="admin-table-header">
                <div>
                    <h3>Godziny pracy w miesiącu</h3>
                    <p>Łącznie: @((int)Model.MonthWorkTime.TotalHours)h @Model.MonthWorkTime.Minutes min</p>
                </div>
            </div>
            <div class="dashboard-chart-body"><canvas id="hoursChart"></canvas></div>
        </div>

        <div class="admin-table-card dashboard-chart-card">
            <div class="admin-table-header"><div><h3>Wnioski wg statusu</h3></div></div>
            <div class="dashboard-chart-body"><canvas id="leaveChart"></canvas></div>
        </div>

        <div class="admin-table-card dashboard-chart-card">
            <div class="admin-table-header"><div><h3>Top 5 – godziny w miesiącu</h3></div></div>
            <div class="dashboard-chart-body"><canvas id="topChart"></canvas></div>
        </div>
    </div>

    <div class="leave-back">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Powrót
        </a>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const css = getComputedStyle(document.documentElement);
        Chart.defaults.color = css.getPropertyValue('--text-secondary').trim();
        Chart.defaults.borderColor = css.getPropertyValue('--border').trim();

        function fmtHours(value) {
            const totalMinutes = Math.round(value * 60);
            const h = Math.floor(totalMinutes / 60);
            const m = totalMinutes % 60;
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
        }

        const hoursTooltip = {
            callbacks: {
                label: ctx => {
                    const value = ctx.chart.options.indexAxis === 'y'
                        ? ctx.parsed.x
                        : ctx.parsed.y;
                    return 'Czas pracy: ' + fmtHours(value);
                }
            }
        };

        new Chart(document.getElementById('hoursChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.DayLabels)),
                datasets: [{
                    label: 'Godziny',
                    data: @Html.Raw(Json.Serialize(Model.DayHours)),
                    backgroundColor: '#3b82f6',
                    borderRadius: 6
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: hoursTooltip },
                scales: { y: { ticks: { callback: v => fmtHours(v) } } }
            }
        });

        new Chart(document.getElementById('leaveChart'), {
            type: 'doughnut',
            data: {
                labels: ['Zaakceptowane', 'Oczekujące', 'Odrzucone'],
                datasets: [{
                    data: [@Model.ApprovedCount, @Model.PendingCount, @Model.RejectedCount],
                    backgroundColor: ['#16a34a', '#d97706', '#dc2626'],
                    borderWidth: 0
                }]
            },
            options: { maintainAspectRatio: false }
        });

        new Chart(document.getElementById('topChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TopNames)),
                datasets: [{
                    label: 'Godziny',
                    data: @Html.Raw(Json.Serialize(Model.TopHours)),
                    backgroundColor: '#10b981',
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: hoursTooltip },
                scales: { x: { ticks: { callback: v => fmtHours(v) } } }
            }
        });
    </script>

}