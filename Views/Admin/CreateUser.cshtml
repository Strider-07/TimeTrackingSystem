@{
    ViewData["Title"] = "Dodawanie użytkownika";
}

<section class="admin-page">

    <div class="admin-header">
        <div>
            <span class="admin-eyebrow">ADMINISTRACJA</span>
            <h1>Dodawanie użytkownika</h1>
            <p>Utwórz nowe konto w systemie ewidencji czasu pracy.</p>
        </div>

        <div class="admin-header-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
    </div>

    <div class="admin-form-card">

        <div class="admin-form-heading">
            <div class="admin-form-heading-icon">
                <i class="bi bi-person-plus"></i>
            </div>
            <div>
                <h3>Nowe konto</h3>
                <p>Wypełnij dane nowego pracownika.</p>
            </div>
        </div>

        <form asp-controller="Admin"
              asp-action="CreateUser"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="admin-validation-summary"></div>

            <div class="admin-form-grid">

                <div class="admin-form-group full-width">
                    <label for="Email">Adres email</label>
                    <input type="email"
                           id="Email"
                           name="Email"
                           class="form-control"
                           autocomplete="email"
                           required />
                </div>

                <div class="admin-form-group full-width">
                    <label for="Password">Hasło</label>
                    <input type="password"
                           id="Password"
                           name="Password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="8"
                           required />
                    <small class="admin-form-hint">
                        Hasło powinno mieć co najmniej 8 znaków.
                    </small>
                </div>

                <div class="admin-form-group">
                    <label for="FirstName">Imię</label>
                    <input type="text"
                           id="FirstName"
                           name="FirstName"
                           class="form-control"
                           autocomplete="given-name"
                           required />
                </div>

                <div class="admin-form-group">
                    <label for="LastName">Nazwisko</label>
                    <input type="text"
                           id="LastName"
                           name="LastName"
                           class="form-control"
                           autocomplete="family-name"
                           required />
                </div>

                <div class="admin-form-group">
                    <label for="Role">Rola</label>
                    <select id="Role"
                            name="Role"
                            class="form-select"
                            required>
                        <option value="Pracownik">Pracownik</option>
                        <option value="Kierownik">Kierownik</option>
                        <option value="Administrator">Administrator</option>
                    </select>
                </div>

                <div class="admin-form-group">
                    <label for="Position">Stanowisko</label>
                    <input type="text"
                           id="Position"
                           name="Position"
                           class="form-control"
                           required />
                </div>

                <div class="admin-form-group">
                    <label for="Department">Dział</label>
                    <input type="text"
                           id="Department"
                           name="Department"
                           class="form-control"
                           required />
                </div>

                <div class="admin-form-group">
                    <label for="IsActive">Status konta</label>
                    <select id="IsActive"
                            name="IsActive"
                            class="form-select"
                            required>
                        <option value="true">Aktywny</option>
                        <option value="false">Nieaktywny</option>
                    </select>
                </div>

            </div>

            <div class="admin-form-actions">
                <a asp-controller="Admin"
                   asp-action="Users"
                   class="btn admin-secondary-btn">
                    <i class="bi bi-arrow-left"></i>
                    Powrót
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-plus-fill"></i>
                    Utwórz konto
                </button>
            </div>

        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
