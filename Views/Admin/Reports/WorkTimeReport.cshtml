@model TimeTrackingSystem.Models.ViewModels.PaginationViewModel<TimeTrackingSystem.Models.ViewModels.WorkTimeViewModel>
@{
    string Fmt(TimeSpan t) => $"{(int)t.TotalHours:D2}:{t.Minutes:D2}:{t.Seconds:D2}";
}
@{
    ViewData["Title"] = "Raport czasu pracy";

    var totalWorkTime = TimeSpan.Zero;

    if (Model != null)
    {
        foreach (var workTime in Model.Items)
        {
            totalWorkTime += workTime.WorkTime;
        }
    }

    var totalHours = (int)totalWorkTime.TotalHours;
    var totalMinutes = totalWorkTime.Minutes;
    var totalSeconds = totalWorkTime.Seconds;
}

<section class="admin-page report-page">

    <div class="admin-header">
        <div>
            <span class="admin-eyebrow">RAPORTY</span>
            <h1>Raport czasu pracy</h1>
            <p>Zestawienie czasu pracy pracowników.</p>
        </div>

        <div class="admin-header-icon">
            <i class="bi bi-clock-history"></i>
        </div>
    </div>

    <div class="report-summary-grid">

        <div class="report-summary-card">
            <div class="report-summary-icon total-time-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div>
                <span class="report-summary-label">Łączny czas pracy</span>

                <h2>
                    @Fmt(totalWorkTime)
                </h2>

                <span class="report-summary-caption">Godziny : minuty : sekudny</span>
            </div>
        </div>

        <div class="report-summary-card">
            <div class="report-summary-icon employee-count-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <span class="report-summary-label">Pracownicy w raporcie</span>

                <h2>@(Model?.TotalItems ?? 0)</h2>

                <span class="report-summary-caption">
                    Pozycje w zestawieniu
                </span>
            </div>
        </div>

    </div>

    <form method="get" class="mb-3 d-flex gap-2">
        <input type="month" name="month" value="@ViewBag.Month" class="form-control w-auto" />
        <button type="submit" class="btn btn-primary">Pokaż</button>
    </form>

    <div class="admin-table-card report-table-card">

        <div class="admin-table-header">
            <div>
                <h3>Zestawienie pracowników</h3>
                <p>Indywidualny czas pracy dla każdego pracownika.</p>
            </div>
        </div>

        @if (Model != null && Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table admin-users-table report-work-table align-middle">
                    <thead>
                        <tr>
                            <th>Pracownik</th>
                            <th>Stanowisko</th>
                            <th>Czas pracy</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var workTime in Model.Items)
                        {
                            

                            <tr>
                                <td>
                                    <div class="admin-user-cell">
                                        <div class="admin-user-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>

                                        <strong>
                                            @workTime.User.FirstName
                                            @workTime.User.LastName
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    @workTime.User.Position
                                </td>

                                <td>
                                    <span class="report-work-time">
                                        <i class="bi bi-clock-fill"></i>
                                        @Fmt(workTime.WorkTime)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-container" aria-label="Nawigacja stron">

                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="WorkTimeReport"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               class="pagination-arrow">
                                <i class="bi bi-chevron-left"></i>

                            </a>
                        }

                        <div class="pagination-pages">
                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 1);
                                int endPage = Math.Min(Model.TotalPages, startPage + 2);
                                startPage = Math.Max(1, endPage - 2);
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a asp-action="WorkTimeReport"
                                   asp-route-page="@i"
                                   class="pagination-page @(i == Model.CurrentPage ? "active" : "")"
                                   aria-current="@(i == Model.CurrentPage ? "page" : null)">
                                    @i
                                </a>
                            }
                        </div>

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="WorkTimeReport"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               class="pagination-arrow">

                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }

                        <form asp-action="WorkTimeReport"
                              method="get"
                              class="pagination-jump">

                            <input type="number"
                                   name="page"
                                   min="1"
                                   max="@Model.TotalPages"
                                   value="@Model.CurrentPage"
                                   aria-label="Numer strony"
                                   required />

                            <span>/ @Model.TotalPages</span>

                            <button type="submit" title="Przejdź do strony">
                                <i class="bi bi-arrow-right"></i>
                            </button>

                        </form>

                    </nav>
                }
            </div>
        }
        else
        {
            <div class="admin-empty-state">
                <i class="bi bi-clock"></i>
                <h4>Brak danych</h4>
                <p>Nie znaleziono danych dotyczących czasu pracy.</p>
            </div>
        }

    </div>

    <div class="report-page-actions">
        <a asp-controller="Admin"
           asp-action="Reports"
           class="btn admin-secondary-btn">
            <i class="bi bi-arrow-left"></i>
            Powrót
        </a>
    </div>

    <div class="report-page-actions">
        <a asp-action="ExportWorkTimeReport"
           asp-route-month="@ViewBag.Month"
           class="btn admin-secondary-btn">
            Wyeksportuj do csv
        </a>
    </div>

    <div class="report-page-actions">
        <a asp-action="ExportWorkTimeReportPdf"
           asp-route-month="@ViewBag.Month"
           class="btn admin-secondary-btn">
            <i class="bi bi-file-earmark-pdf"></i> Wyeksportuj do PDF
        </a>
    </div>

</section>