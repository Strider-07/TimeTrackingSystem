@model List<TimeTrackingSystem.Models.Entities.ApplicationUser>

<table>
    <thead>
        <tr>
            <th>Imie</th>
            <th>Nazwisko</th>
            <th>Stanowisko</th>
            <th>Godziny pracy</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Position</td>
                <td>10</td>
            </tr>
        }
    </tbody>
</table>

<h2>Łącznie: [ilość godzin]</h2>