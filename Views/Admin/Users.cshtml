@model List<TimeTrackingSystem.Models.Entities.ApplicationUser>

<h1>Lista pracowników</h1>

<table>
    <thead>
        <tr>
            <th>Imie</th>
            <th>Nazwisko</th>
            <th>Stanowisko</th>
            <th>Dział</th>
            <th>Status</th>
            <th>Opcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Position</td>
                <td>@user.Department</td>
                <td>@(user.IsActive ? "Aktywny" : "Nieaktywny")</td>
                <td>
                    <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-primary">Edytuj</a>
                    <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <button type="submit" class="btn btn-primary">Usuń</button>
                    </form>
                    <a asp-controller="Admin" asp-action="ChangeUserPassword" asp-route-id="@user.Id" class="btn btn-primary">Zmień hasło</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary">Dodaj użytkownika</a>
</div>