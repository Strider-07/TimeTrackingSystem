@model List<TimeTrackingSystem.Models.Entities.ApplicationUser>

<h1>Lista pracowników</h1>

<table>
    <thead>
        <tr>
            <th>Imie</th>
            <th>Nazwisko</th>
            <th>Stanowisko</th>
            <th>Dział</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Position</td>
                <td>@user.Department</td>
                <td>@(user.IsActive ? "Aktywny" : "Nieaktywny")</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary">Dodaj użytkownika</a>
</div>