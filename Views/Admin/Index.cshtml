@{
    ViewData["Title"] = "Panel administratora";
}

<section class="admin-page">
    <div class="admin-header">
        <div>
            <span class="admin-eyebrow">ADMINISTRACJA</span>
            <h1>Panel administratora</h1>
            <p>Zarządzaj pracownikami i monitoruj dane systemu.</p>
        </div>

        <div class="admin-header-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
    </div>

    <div class="admin-dashboard-grid">

        <a asp-controller="Admin"
           asp-action="Users"
           class="admin-dashboard-card">

            <div class="admin-dashboard-card-icon employees-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="admin-dashboard-card-content">
                <h3>Zarządzanie pracownikami</h3>
                <p>Dodawaj, edytuj, aktywuj i dezaktywuj konta pracowników.</p>
            </div>

            <div class="admin-dashboard-card-footer">
                <span>Zarządzaj pracownikami</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>

        <a asp-controller="Admin"
           asp-action="Reports"
           class="admin-dashboard-card">

            <div class="admin-dashboard-card-icon reports-icon">
                <i class="bi bi-bar-chart-fill"></i>
            </div>

            <div class="admin-dashboard-card-content">
                <h3>Raporty</h3>
                <p>Przeglądaj raporty i informacje dotyczące czasu pracy.</p>
            </div>

            <div class="admin-dashboard-card-footer">
                <span>Przejdź do raportów</span>
                <i class="bi bi-arrow-right"></i>
            </div>
        </a>
        <div class="leave-back">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Powrót
            </a>
        </div>

    </div>
</section>
