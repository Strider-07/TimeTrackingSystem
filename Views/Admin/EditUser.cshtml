@model TimeTrackingSystem.Models.ViewModels.EditUserViewModel

<form asp-controller="Admin" asp-action="EditUser" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <h2 class="fw-bold">Edytowanie użytkownika</h2>

    <input type="hidden" asp-for="UserId" />

    <label>Email: <input asp-for="Email" required /></label>
    <label>Imię: <input asp-for="FirstName" required /></label>
    <label>Nazwisko: <input asp-for="LastName" required /></label>

    <label>
        Rola:
        <select asp-for="Role">
            <option value="Pracownik">Pracownik</option>
            <option value="Kierownik">Kierownik</option>
            <option value="Administrator">Administrator</option>
        </select>
    </label>

    <label>Stanowisko: <input asp-for="Position" required /></label>
    <label>Dział: <input asp-for="Department" required /></label>

    <button class="btn btn-primary" type="submit">Edytuj</button>
</form>
