@model TimeTrackingSystem.Models.Entities.ApplicationUser;

<!--Editing users-->
<form asp-controller="Admin" asp-action="EditUser" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <h2 class="fw-bold">Edytowanie użytkownika</h2>
    <label>Email: <input type="text" required name="Email" value="@Model.Email"/></label>
    <label>Imie: <input type="text" required name="FirstName" value="@Model.FirstName"/></label>
    <label>Nazwisko: <input type="text" required name="LastName" value="@Model.LastName"/></label>
    <label>
        Stanowisko:
        <select name="Position">
            <option value="Pracownik" selected="@(Model.Position == "Pracownik" ? true : false )">Pracownik</option>
            <option value="Kierownik" selected="@(Model.Position == "Kierownik" ? true : false)">Kierownik</option>
            <option value="Administrator" selected="@(Model.Position == "Administrator" ? true : false)">Administrator</option>
        </select>
    </label>
    <label>Dział: <input type="text" required name="Department" value="@Model.Department"/></label>
    <label>
        Aktywny:
        <select name="IsActive">
            <option value="true" selected="@Model.IsActive">Tak</option>
            <option value="false" selected="@(!Model.IsActive)">Nie</option>
        </select>
    </label>
    <button class="btn btn-primary" type="submit">Edytuj</button>
</form>
