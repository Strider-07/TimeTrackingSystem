@model List<TimeTrackingSystem.Models.ViewModels.AdminPanelUserViewModel>

@{
    ViewData["Title"] = "Lista pracowników";
}

<section class="admin-page">

    <div class="admin-header">
        <div>
            <span class="admin-eyebrow">EWIDENCJA CZASU</span>
            <h1>Lista pracowników</h1>
            <p>Przeglądaj pracowników i ich zarejestrowany czas pracy.</p>
        </div>

        <div class="admin-header-icon">
            <i class="bi bi-people-fill"></i>
        </div>
    </div>

    <div class="admin-table-card">

        <div class="admin-table-header">
            <div>
                <h3>Pracownicy</h3>
                <p>Lista pracowników dostępnych w systemie.</p>
            </div>

            <div class="employee-count-badge">
                <i class="bi bi-people-fill"></i>
                <span>@(Model?.Count ?? 0) pracowników</span>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table admin-users-table align-middle">
                    <thead>
                        <tr>
                            <th>Pracownik</th>
                            <th>Stanowisko</th>
                            <th>Dział</th>
                            <th>Rola</th>
                            <th>Status</th>
                            <th class="text-end">Opcje</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="admin-user-cell">
                                        <div class="admin-user-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                @user.FirstName @user.LastName
                                            </strong>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.Position) ? "—" : user.Position)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.Department) ? "—" : user.Department)
                                </td>

                                <td>
                                    <span class="admin-user-role @(
                                          user.Role == "Administrator" ? "role-admin" :
                                          user.Role == "Kierownik" ? "role-manager" :
                                          user.Role == "Pracownik" ? "role-employee" :
                                          "role-unknown")">

                                        <i class="bi @(
                                           user.Role == "Administrator" ? "bi-shield-fill" :
                                           user.Role == "Kierownik" ? "bi-people-fill" :
                                           user.Role == "Pracownik" ? "bi-person-fill" :
                                           "bi-question-circle-fill")"></i>

                                        @user.Role
                                    </span>
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="admin-user-status active">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Aktywny
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-user-status inactive">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Nieaktywny
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="employee-entries-actions">
                                        <a asp-controller="WorkEntry"
                                           asp-action="ShowEntries"
                                           asp-route-id="@user.Id"
                                           class="employee-view-entries-btn">

                                            <i class="bi bi-clock-history"></i>
                                            <span>Zobacz wpisy</span>
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="admin-empty-state">
                <i class="bi bi-people"></i>
                <h4>Brak pracowników</h4>
                <p>Nie znaleziono żadnych pracowników w systemie.</p>
            </div>
        }

    </div>
    <div class="leave-back">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Powrót
        </a>
    </div>

</section>
