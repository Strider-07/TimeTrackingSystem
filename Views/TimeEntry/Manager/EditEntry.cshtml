@model TimeTrackingSystem.Models.ViewModels.EditTimeEntryViewModel

@{
    var hasEnd = Model.EndDate.HasValue && Model.EndHour.HasValue;

    var workTime = hasEnd
        && Model.StartDate.HasValue
        && Model.StartHour.HasValue
        && Model.EndDate.HasValue
        && Model.EndHour.HasValue
            ? Model.EndDate.Value.ToDateTime(Model.EndHour.Value)
                - Model.StartDate.Value.ToDateTime(Model.StartHour.Value)
            : TimeSpan.Zero;
}

<section class="work-dashboard edit-entry-page">

    <!-- NAGŁÓWEK -->
    <div class="dashboard-header">
        <div>
            <h1>Edycja wpisu czasu pracy</h1>
            <p>Dokonaj korekty zarejestrowanego czasu pracy.</p>
        </div>

        <div class="header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
    </div>

    <!-- PRACOWNIK -->
    <div class="card main-work-card edit-employee-card">
        <div class="card-body">

            <div class="edit-employee-icon">
                <i class="bi bi-person-circle"></i>
            </div>

            <div class="edit-employee-info">
                <span class="section-label">EDYTOWANY PRACOWNIK</span>

                <h3>
                    @ViewBag.EmployeeName
                </h3>

                <span class="text-secondary">
                    Korekta wpisu czasu pracy
                </span>
            </div>

            <div class="edit-entry-status">
                @if (hasEnd)
                {
                    <span class="badge rounded-pill bg-success-subtle text-success">
                        <i class="bi bi-check-circle"></i>
                        Zakończony
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-warning-subtle text-warning">
                        <i class="bi bi-clock"></i>
                        Aktywny
                    </span>
                }
            </div>

        </div>
    </div>

    <!-- FORMULARZ -->
    <form asp-controller="TimeEntry"
          asp-action="EditEntry"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <!-- BŁĘDY WALIDACJI -->
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="card main-work-card edit-entry-card">
            <div class="card-body">

                <!-- ROZPOCZĘCIE -->
                <div class="edit-section-header">

                    <div class="edit-section-icon start-icon">
                        <i class="bi bi-play-circle"></i>
                    </div>

                    <div>
                        <h4>Rozpoczęcie pracy</h4>
                        <p>Data i godzina rozpoczęcia pracy.</p>
                    </div>

                </div>

                <div class="edit-fields">

                    <div class="edit-field">
                        <label asp-for="StartDate">
                            <i class="bi bi-calendar-event"></i>
                            Data rozpoczęcia
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control"
                               required />

                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="edit-field">
                        <label asp-for="StartHour">
                            <i class="bi bi-clock"></i>
                            Godzina rozpoczęcia
                        </label>

                        <input asp-for="StartHour"
                               type="time"
                               class="form-control"
                               required />

                        <span asp-validation-for="StartHour"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="edit-divider" />

                <!-- ZAKOŃCZENIE -->
                <div class="edit-section-header">

                    <div class="edit-section-icon end-icon">
                        <i class="bi bi-stop-circle"></i>
                    </div>

                    <div>
                        <h4>Zakończenie pracy</h4>
                        <p>Data i godzina zakończenia pracy.</p>
                    </div>

                </div>

                <div class="edit-fields">

                    <div class="edit-field">
                        <label asp-for="EndDate">
                            <i class="bi bi-calendar-event"></i>
                            Data zakończenia
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>

                    <div class="edit-field">
                        <label asp-for="EndHour">
                            <i class="bi bi-clock"></i>
                            Godzina zakończenia
                        </label>

                        <input asp-for="EndHour"
                               type="time"
                               class="form-control" />

                        <span asp-validation-for="EndHour"
                              class="text-danger"></span>
                    </div>

                </div>

                <small class="field-hint">
                    Pozostaw oba pola zakończenia puste, aby wpis pozostał aktywny.
                </small>

                <hr class="edit-divider" />

                <!-- CZAS PRACY -->
                <div class="edit-duration-box">

                    <div class="edit-duration-icon">
                        <i class="bi bi-stopwatch"></i>
                    </div>

                    <div>
                        <span class="stats-label">
                            Aktualny czas pracy
                        </span>

                        @if (hasEnd && workTime >= TimeSpan.Zero)
                        {
                            <h3>
                                @workTime.ToString(@"d\.hh\:mm\:ss")
                            </h3>
                        }
                        else if (hasEnd)
                        {
                            <h3 class="text-danger">
                                Nieprawidłowy zakres czasu
                            </h3>
                        }
                        else
                        {
                            <h3 class="text-success">
                                W trakcie
                            </h3>
                        }
                    </div>

                </div>

                <!-- UZASADNIENIE -->
                <div class="edit-reason-section">

                    <div class="edit-section-header">

                        <div class="edit-section-icon reason-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                        <div>
                            <h4>Uzasadnienie korekty</h4>
                            <p>Podaj powód wprowadzenia zmian.</p>
                        </div>

                    </div>

                    <div class="edit-field">

                        <label asp-for="Note">
                            Powód korekty
                        </label>

                        <textarea asp-for="Note"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Np. Pracownik zapomniał zarejestrować zakończenie pracy."
                                  required></textarea>

                        <span asp-validation-for="Note"
                              class="text-danger"></span>

                    </div>

                </div>

            </div>
        </div>

        <!-- PRZYCISKI -->
        <div class="edit-entry-actions">

            <a asp-controller="TimeEntry"
               asp-action="ShowEntries"
               asp-route-id="@ViewBag.UserId"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Anuluj

            </a>

            <button type="submit" class="btn btn-primary">

                <i class="bi bi-check-lg"></i>
                Zapisz zmiany

            </button>

        </div>

    </form>

</section>
