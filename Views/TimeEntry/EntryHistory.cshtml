@model TimeTrackingSystem.Models.ViewModels.PaginationViewModel<TimeTrackingSystem.Models.Entities.TimeEntry>

@{
    var totalWorkTime = Model.Items.Aggregate(
        TimeSpan.Zero,
        (total, entry) => total + entry.WorkTime()
    );
}

<section class="work-dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Historia czasu pracy</h1>
            <p>Przeglądaj swoje dotychczasowe wpisy.</p>
        </div>

        <div class="header-icon">
            <i class="bi bi-clock-history"></i>
        </div>
    </div>

    <!-- PODSUMOWANIE -->

    <div class="card main-work-card history-summary">
        <div class="card-body">

            <div class="stats-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <p class="stats-label">Łączny czas pracy</p>

            <h2>
                @totalWorkTime.ToString(@"d\.hh\:mm\:ss")
            </h2>

            <span class="text-secondary">
                Liczba wpisów: @Model.TotalItems
            </span>

        </div>
    </div>

    <!-- LISTA WPISÓW -->

    <div class="history-list">

        <div class="history-list-header">
            <h2>Twoje wpisy</h2>
            <span class="badge bg-primary-subtle text-primary rounded-pill">
                @Model.Items.Count wpisów
            </span>
        </div>

        @if (Model.Items.Any())
        {

            @foreach (var entry in Model.Items.OrderByDescending(x => x.StartTime))
            {
                <div class="card history-card">

                    <div class="card-body">

                        <div class="history-card-main">

                            <div class="history-date-icon">
                                <i class="bi bi-calendar3"></i>
                            </div>

                            <div class="history-date">
                                <h5>
                                    @entry.EntryDate.ToString("dd MMMM yyyy")
                                </h5>

                                <span>
                                    @entry.EntryDate.ToString("dddd")
                                </span>
                            </div>

                            <div class="history-duration">
                                <span class="stats-label">Czas pracy</span>
                                <h4>
                                    @entry.WorkTime().ToString(@"d\.hh\:mm\:ss")
                                </h4>
                            </div>

                        </div>

                        <hr />

                        <div class="history-details">

                            <div>
                                <span class="detail-label">
                                    <i class="bi bi-play-circle"></i>
                                    Rozpoczęcie
                                </span>

                                <strong>
                                    @entry.StartTime.ToLocalTime().ToString("HH:mm:ss")
                                </strong>
                            </div>

                            <div>
                                <span class="detail-label">
                                    <i class="bi bi-stop-circle"></i>
                                    Zakończenie
                                </span>

                                <strong>
                                    @if (entry.EndTime.HasValue)
                                    {
                                        @entry.EndTime.Value.ToLocalTime().ToString("HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span class="text-success">W trakcie</span>
                                    }
                                </strong>
                            </div>

                            <div class="history-status">
                                @if (entry.EndTime.HasValue)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success">
                                        Zakończony
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning-subtle text-warning">
                                        Aktywny
                                    </span>
                                }
                            </div>

                        </div>

                        @if (entry.ModifiedBy != null)
                        {
                            <div class="history-edited-info">
                                <div class="history-edited-header">
                                    <i class="bi bi-pencil-square"></i>

                                    <span>
                                        Wpis został zmodyfikowany przez:
                                        <strong>@entry.ModifiedBy.FirstName @entry.ModifiedBy.LastName</strong>
                                    </span>
                                </div>

                                <div class="history-edited-note">
                                    <strong class="history-note-label">Opis:</strong>
                                    <span class="history-note-content">@entry.Note</span>
                                </div>
                            </div>
                        }

                    </div>

                </div>
            }
            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-container" aria-label="Nawigacja stron">

                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="EntryHistory"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="pagination-arrow">
                            <i class="bi bi-chevron-left"></i>
                            
                        </a>
                    }

                    <div class="pagination-pages">
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 1);
                            int endPage = Math.Min(Model.TotalPages, startPage + 2);
                            startPage = Math.Max(1, endPage - 2);
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <a asp-action="EntryHistory"
                               asp-route-page="@i"
                               class="pagination-page @(i == Model.CurrentPage ? "active" : "")"
                               aria-current="@(i == Model.CurrentPage ? "page" : null)">
                                @i
                            </a>
                        }
                    </div>

                    @if (Model.HasNextPage)
                    {
                        <a asp-action="EntryHistory"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="pagination-arrow">
                            
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }

                    <form asp-action="EntryHistory"
                          method="get"
                          class="pagination-jump">

                        <input type="number"
                               name="page"
                               min="1"
                               max="@Model.TotalPages"
                               value="@Model.CurrentPage"
                               aria-label="Numer strony"
                               required />

                        <span>/ @Model.TotalPages</span>

                        <button type="submit" title="Przejdź do strony">
                            <i class="bi bi-arrow-right"></i>
                        </button>

                    </form>

                </nav>
            }

        }
        else
        {
            <div class="card empty-history">
                <div class="card-body text-center">

                    <i class="bi bi-calendar-x"></i>

                    <h4>Brak wpisów</h4>

                    <p>
                        Nie masz jeszcze żadnych zarejestrowanych wpisów czasu pracy.
                    </p>

                    <a asp-controller="TimeEntry"
                       asp-action="Index"
                       class="btn btn-primary">
                        Wróć do panelu
                    </a>

                </div>
            </div>
        }

    </div>

    <div class="history-section">
        <a asp-controller="TimeEntry"
           asp-action="Index"
           class="btn btn-primary btn-lg">

            <i class="bi bi-arrow-left"></i>
            Powrót

        </a>
    </div>

</section>
